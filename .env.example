# 后端默认启动配置
# 数字人口型模型，可选: wav2lip / musetalk / ultralight
AVATARHUMAN_MODEL=wav2lip
# 使用哪个数字人素材目录，对应 data/avatars/<avatar_id>
AVATARHUMAN_AVATAR_ID=model_wxb_25fps
# TTS 服务类型，可选: edgetts / gpt-sovits / xtts / cosyvoice / fishtts / tencent / index_tts
AVATARHUMAN_TTS=index_tts
# 默认音色。
# 如果是 edgetts，这里填语音名；如果是其他 TTS，一般填参考音频或服务要求的 voice id
AVATARHUMAN_REF_FILE=/home/ubuntu/projects/stable/index-tts-vllm/ref/ref.wav
# 部分 TTS 会用到的参考文本，edgetts 基本可忽略
AVATARHUMAN_REF_TEXT=当归性温味甘，补血活血，常用于妇科疾病
# 外部 TTS 服务地址。只有 gpt-sovits / xtts / cosyvoice / fishtts / index_tts 等模式通常需要改
AVATARHUMAN_TTS_SERVER=http://127.0.0.1:6006
# Web 服务监听端口，浏览器访问 http://127.0.0.1:8010
AVATARHUMAN_LISTEN_PORT=8010
# 最大并发会话数
AVATARHUMAN_MAX_SESSION=8
# 推理批大小，越大通常越吃显存
AVATARHUMAN_BATCH_SIZE=16
# 传输模式，可选: webrtc / rtmp / rtcpush
AVATARHUMAN_TRANSPORT=webrtc
# 仅在 transport=rtcpush 时使用的推流地址
AVATARHUMAN_PUSH_URL=http://localhost:1985/rtc/v1/whip/?app=live&stream=livestream
# 音频帧率，通常保持默认 50
AVATARHUMAN_FPS=50
# 运行时宽度
AVATARHUMAN_WIDTH=450
# 运行时高度
AVATARHUMAN_HEIGHT=450
# 推理窗口左侧步长，通常保持默认
AVATARHUMAN_STRIDE_LEFT=10
# 推理窗口中间步长，通常保持默认
AVATARHUMAN_STRIDE_MIDDLE=8
# 推理窗口右侧步长，通常保持默认
AVATARHUMAN_STRIDE_RIGHT=10
# 自定义动作配置文件路径，不用就留空
AVATARHUMAN_CUSTOM_VIDEO_CONFIG=

# Coze 代理配置
# Coze API token，前端不会直接读取它，而是由后端代理使用
COZE_API_TOKEN=
# Coze bot id
COZE_BOT_ID=

# 前端配置路径
# Coze 页面读取的配置文件路径
VITE_COZE_CONFIG_PATH=/config/cozechat.json
# LangChain 页面读取的配置文件路径
VITE_LANGCHAIN_CONFIG_PATH=/config/langchain.json
# 预设问题列表文件路径
VITE_PROMPT_PATH=/prompt.json
